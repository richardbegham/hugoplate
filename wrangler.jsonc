{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hugoplate",
  "compatibility_date": "2026-04-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "chmod a+x build.sh && ./build.sh"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
